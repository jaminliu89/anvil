{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "notification:default",
    "global-shortcut:default",
    "autostart:default",
    "store:default",
    "window-state:default",
    "window:default",
    "window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
